<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_host" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/widget_root" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="172dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/widget_main">
            <ImageView android:id="@+id/widget_cover" android:layout_width="172dp" android:layout_height="172dp" android:scaleType="centerCrop" android:contentDescription="@string/widget_cover_description" android:src="@drawable/icon_canvas_99"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:layout_marginStart="16dp" android:id="@+id/widget_metadata">
                <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#f3f3ee" android:textSize="19sp" android:maxLines="2" android:ellipsize="end" android:includeFontPadding="true"/>
                <TextView android:id="@+id/widget_album" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_empty" android:textColor="#a9aba8" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:layout_marginTop="7dp"/>
                <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
                <LinearLayout android:id="@+id/widget_controls" android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                    <FrameLayout android:id="@+id/widget_previous_cell" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
                        <ImageButton android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:id="@+id/widget_previous" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:padding="12dp" android:src="@drawable/widget_previous" android:contentDescription="@string/widget_previous"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/widget_play_cell" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
                        <ImageButton android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:id="@+id/widget_play" android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:background="@drawable/widget_play_background" android:padding="12dp" android:src="@drawable/widget_play" android:contentDescription="@string/widget_play_pause"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/widget_next_cell" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
                        <ImageButton android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:padding="12dp" android:src="@drawable/widget_next" android:contentDescription="@string/widget_next"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="19dp">
            <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="16dp" android:gravity="end|center_vertical" android:text="@string/widget_time_zero" android:textColor="#a9aba8" android:textSize="11sp" android:maxLines="1" android:includeFontPadding="false"/>
            <ProgressBar android:padding="0dp" android:progressDrawable="@drawable/widget_progress" android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="bottom" android:progressTint="#edede7" android:progressBackgroundTint="#40433f" android:max="1000" android:progress="0"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
