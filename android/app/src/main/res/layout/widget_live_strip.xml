<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_host" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/widget_root" android:clipToPadding="false" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:gravity="center_vertical" android:orientation="vertical" android:background="@drawable/widget_background" android:padding="12dp">
        <LinearLayout android:id="@+id/widget_main" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/widget_cover" android:layout_width="52dp" android:layout_height="52dp" android:scaleType="centerCrop" android:contentDescription="@string/widget_cover_description" android:src="@drawable/icon_canvas_99"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:layout_marginStart="12dp" android:id="@+id/widget_metadata">
                <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#f3f3ee" android:textSize="16sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true"/>
                <TextView android:id="@+id/widget_album" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_empty" android:textColor="#a9aba8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="true" android:layout_marginTop="5dp"/>
            </LinearLayout>
            <ImageButton android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:padding="14dp" android:src="@drawable/widget_previous" android:contentDescription="@string/widget_previous"/>
            <ImageButton android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_play_background" android:padding="14dp" android:src="@drawable/widget_play" android:contentDescription="@string/widget_play_pause"/>
            <ImageButton android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:padding="14dp" android:src="@drawable/widget_next" android:contentDescription="@string/widget_next"/>
        </LinearLayout>
        <ProgressBar android:padding="0dp" android:progressDrawable="@drawable/widget_progress" android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="8dp" android:progressTint="#edede7" android:progressBackgroundTint="#40433f" android:max="1000" android:progress="0"/>
        <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_time_zero" android:textColor="#a9aba8" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:layout_marginTop="5dp"/>
    </LinearLayout>
</FrameLayout>
