    android:minWidth="110dp" android:minHeight="110dp"
    android:minResizeWidth="110dp" android:minResizeHeight="110dp"
    android:targetCellWidth="2" android:targetCellHeight="2"
    android:initialLayout="@layout/widget_preview_square" android:previewLayout="@layout/widget_preview_square"
    android:previewImage="@drawable/music_widget_compact_preview"
    android:resizeMode="horizontal|vertical" android:widgetCategory="home_screen"
    android:updatePeriodMillis="0" android:description="@string/widget_description" />
